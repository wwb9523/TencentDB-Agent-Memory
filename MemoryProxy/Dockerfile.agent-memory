# Add the independent memory API to a pinned, already-running Proxy image.
# Pass the existing image ID/digest as BASE_IMAGE; no dependency downloads.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --chown=app:app MemoryProxy/src/server.ts /app/src/server.ts
COPY --chown=app:app MemoryProxy/src/memory/agent-memory.ts /app/src/memory/agent-memory.ts
COPY --chown=app:app ../install-tdai-memory.sh /app/install-tdai-memory.sh
